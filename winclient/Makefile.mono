
all: clean resources justjournal.exe

justjournal.exe: About.cs Options.cs Login.cs PostForm.cs Mood.cs RtfToHtml.cs JustJournal.cs SpellCheck.cs
	gmcs -pkg:dotnet -r:System.Web.Extensions.dll -r:packages/WeCantSpell.Hunspell.2.1.0/lib/net45/WeCantSpell.Hunspell.dll -out:justjournal.exe -resource:JustJournal.AboutForm.resources About.cs -resource:JustJournal.Login.resources Login.cs -resource:JustJournal.Options.resources Options.cs -resource:JustJournal.PostForm.resources PostForm.cs JustJournal.cs Mood.cs RtfToHtml.cs SpellCheck.cs

resources: About.resx Login.resx Options.resx PostForm.resx
	resgen About.resx JustJournal.AboutForm.resources
	resgen Login.resx JustJournal.Login.resources
	resgen Options.resx JustJournal.Options.resources
	resgen PostForm.resx JustJournal.PostForm.resources

clean:
	rm -f a.out justjournal.exe
